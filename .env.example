# AttendX Root Environment Variables
# Copy this file to .env and change the secrets for production

# Database Configuration (Used by Postgres container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Abhi@98250
POSTGRES_DB=attendx

# Backend Secrets
# JWT_SECRET MUST be at least 32 characters long
JWT_SECRET=super_secure_jwt_secret_phrase_that_is_long_enough

# Frontend API URL (Visible to clients)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
