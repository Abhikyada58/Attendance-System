model QRCodeToken {
  id        String   @id @default(uuid())
  sessionId String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([sessionId])
  @@index([expiresAt])
}
